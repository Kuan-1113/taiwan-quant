# Discord Webhook（#毛 頻道）
DISCORD_WEBHOOK_SIGNAL=https://discord.com/api/webhooks/...

# 掃描設定
SCAN_MARKET=both        # twse / tpex / both
MAX_WORKERS=20          # 平行下載執行緒數
MIN_AVG_VOLUME=1000     # 日均量下限（張）

# 排程
SCHEDULE_TIME=17:00
TIMEZONE=Asia/Taipei

# 技術指標門檻
ADX_TREND_THRESHOLD=25
RSI_OVERSOLD=40
RSI_OVERBOUGHT=75
VOLUME_MULT=1.5

# 評分星級門檻
SCORE_THREE_STAR=80
SCORE_TWO_STAR=60
SCORE_ONE_STAR=40
